{
  "name": "@chrischall/microsoft-teams-mcp",
  "version": "0.12.0",
  "mcpName": "io.github.chrischall/microsoft-teams-mcp",
  "description": "Microsoft Teams MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/microsoft-teams-mcp.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "microsoft-teams",
    "teams",
    "office365",
    "microsoft365",
    "chat"
  ],
  "type": "module",
  "bin": {
    "microsoft-teams-mcp": "dist/bundle.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "server.json",
    "skills",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --external:dotenv --external:@napi-rs/canvas --define:process.env.FETCHPROXY_WS_PORT=undefined --define:process.env.WS_NO_BUFFER_UTIL='\"1\"' --define:process.env.WS_NO_UTF_8_VALIDATE='\"1\"' --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^3.9.0",
    "@fetchproxy/server": "^3.8.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@napi-rs/canvas": "^1.1.1",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
