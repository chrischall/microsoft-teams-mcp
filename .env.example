# Everything here is optional. By default the chat-service token is captured
# once from your signed-in teams.cloud.microsoft tab through the ContextMint
# Bridge browser extension, then cached; every read after that is a plain
# server-side request. Only the Activity feed still reads the page.

# A chat-service bearer token (the JWT itself) to use instead of capturing one.
# TEAMS_ACCESS_TOKEN=
# Never capture from the browser (then TEAMS_ACCESS_TOKEN is required).
# TEAMS_DISABLE_FETCHPROXY=false

# Chat-service region in the API path, or a full base-URL override.
# TEAMS_CHATSVC_REGION=amer
# TEAMS_CHATSVC_BASE=https://teams.cloud.microsoft/api/chatsvc/amer/v1

# Seconds to wait for the Teams tab to call its chat service during capture.
# TEAMS_CAPTURE_TIMEOUT=30
# Cache the captured token between runs (~23h lifetime), and where.
# TEAMS_TOKEN_CACHE=true
# TEAMS_TOKEN_FILE=~/.microsoft-teams-mcp/token.json

# fetchproxy concentrator port. 37149 is the fleet-wide shared port the
# ContextMint Bridge extension dials — do not pick a "unique" one.
# TEAMS_WS_PORT=37149
